{
  "$schema": "https://opencode.ai/config.json",
  // "model": "opencode/muse-spark-1.3",
  // "small_model": "opencode/muse-spark-1.3",
  "default_agent": "code",
  "instructions": ["./rules/*.md", "instructions/INSTRUCTIONS.md"],
  "plugin": [
    "./plugins/handoff/plugin.ts",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mode": {
    "code": {
      "description": "Primary coding agent for development work",
      "mode": "primary",
      // "model": "opencode/muse-spark-1.3",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "edit": true,
        "bash": true,
        "write": true,
        "patch": true,
        "todowrite": true,
        "webfetch": true
      }
    },
    "night-shift": {
      "description": "Unattended long-run agent: small verified steps, commits locally, never pushes",
      "mode": "primary",
      "prompt": "{file:prompts/agents/night-shift.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "edit": true,
        "bash": true,
        "write": true,
        "patch": true,
        "todowrite": true,
        "webfetch": true
      },
      "permission": {
        "edit:**/.env*": "deny",
        "read:**/.env*": "deny",
        "read:**/*secret*": "deny",
        "read:**/*credential*": "deny",
        "read:**/.ssh/**": "deny",
        "read:**/*.pem": "deny",
        "read:**/*.key": "deny",
        "read:**/node_modules/**": "deny",
        "mcp_*": "allow",
        "bash": {
          "git push*": "deny",
          "rm -rf *": "deny",
          "*": "allow"
        }
      }
    },
    "night-shift-session": {
      "description": "Jarvis dalam sesi: loop improvisasi mandiri atas transkrip berjalan, berhenti + analisa kalau habis bahan",
      "mode": "primary",
      "prompt": "{file:prompts/agents/night-shift-session.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "edit": true,
        "bash": true,
        "write": true,
        "patch": true,
        "todowrite": true,
        "webfetch": true
      },
      "permission": {
        "edit:**/.env*": "deny",
        "read:**/.env*": "deny",
        "read:**/*secret*": "deny",
        "read:**/*credential*": "deny",
        "read:**/.ssh/**": "deny",
        "read:**/*.pem": "deny",
        "read:**/*.key": "deny",
        "read:**/node_modules/**": "deny",
        "mcp_*": "allow",
        "bash": {
          "git push*": "deny",
          "rm -rf *": "deny",
          "*": "allow"
        }
      }
    },
    "code-with-plan": {
      "description": "Primary coding agent for development work with Expert planning specialist for complex features and refactoring",
      "mode": "primary",
      "model": "opencode/muse-spark-1.3",
      "prompt": "{file:prompts/agents/planner.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "edit": true,
        "bash": true,
        "write": true,
        "patch": true,
        "todowrite": true,
        "webfetch": true
      }
    },
    "code-with-reviewer": {
      "description": "Primary coding agent for development work with Expert code review specialist for quality, security, and maintainability",
      "mode": "primary",
      "model": "opencode/muse-spark-1.3",
      "prompt": "{file:prompts/agents/code-reviewer.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "edit": true,
        "bash": true,
        "write": true,
        "patch": true,
        "todowrite": true,
        "webfetch": true
      }
    },
    "planner": {
      "description": "Expert planning specialist for complex features and refactoring",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3",
      "prompt": "{file:prompts/agents/planner.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true,
        "todowrite": true,
        "webfetch": true,
        "write": false,
        "edit": false,
        "patch": false
      }
    },
    "code-reviewer": {
      "description": "Expert code review specialist for quality, security, and maintainability",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3",
      "prompt": "{file:prompts/agents/code-reviewer.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true,
        "todowrite": true,
        "webfetch": true,
        "write": false,
        "edit": false,
        "patch": false
      }
    },
    "security-reviewer": {
      "description": "Security vulnerability detection and remediation specialist",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3",
      "prompt": "{file:prompts/agents/security-reviewer.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "bash": true,
        "write": true,
        "edit": true,
        "patch": true,
        "todowrite": true,
        "webfetch": true
      }
    },
    "tdd-guide": {
      "description": "Test-Driven Development specialist enforcing write-tests-first methodology",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3",
      "prompt": "{file:prompts/agents/tdd-guide.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "write": true,
        "edit": true,
        "bash": true,
        "patch": true,
        "todowrite": true,
        "webfetch": true
      }
    },
    "build-error-resolver": {
      "description": "Build and TypeScript error resolution specialist",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3",
      "prompt": "{file:prompts/agents/build-error-resolver.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "write": true,
        "edit": true,
        "bash": true,
        "patch": true,
        "todowrite": true,
        "webfetch": true
      }
    },
    "e2e-runner": {
      "description": "End-to-end testing specialist using Playwright",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3",
      "prompt": "{file:prompts/agents/e2e-runner.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "write": true,
        "edit": true,
        "bash": true,
        "patch": true,
        "todowrite": true,
        "webfetch": true
      }
    },
    "doc-updater": {
      "description": "Documentation and codemap specialist",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3",
      "prompt": "{file:prompts/agents/doc-updater.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "write": true,
        "edit": true,
        "bash": true,
        "patch": true,
        "todowrite": true,
        "webfetch": true
      }
    },
    "refactor-cleaner": {
      "description": "Dead code cleanup and consolidation specialist",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3",
      "prompt": "{file:prompts/agents/refactor-cleaner.txt}",
      "tools": {
        "read": true,
        "grep": true,
        "glob": true,
        "write": true,
        "edit": true,
        "bash": true,
        "patch": true,
        "todowrite": true,
        "webfetch": true
      }
    }
  },
  "command": {
    "plan": {
      "description": "Create a detailed implementation plan for complex features",
      "template": "{file:commands/plan.md}\n\n$ARGUMENTS",
      "agent": "planner",
      "subtask": true
    },
    "tdd": {
      "description": "Enforce TDD workflow with 80%+ test coverage",
      "template": "{file:commands/tdd.md}\n\n$ARGUMENTS",
      "agent": "tdd-guide",
      "subtask": true
    },
    "code-review": {
      "description": "Review code for quality, security, and maintainability",
      "template": "{file:commands/code-review.md}\n\n$ARGUMENTS",
      "agent": "code-reviewer",
      "subtask": true
    },
    "security": {
      "description": "Run comprehensive security review",
      "template": "{file:commands/security.md}\n\n$ARGUMENTS",
      "agent": "security-reviewer",
      "subtask": true
    },
    "build-fix": {
      "description": "Fix build and TypeScript errors with minimal changes",
      "template": "{file:commands/build-fix.md}\n\n$ARGUMENTS",
      "agent": "build-error-resolver",
      "subtask": true
    },
    "e2e": {
      "description": "Generate and run E2E tests with Playwright",
      "template": "{file:commands/e2e.md}\n\n$ARGUMENTS",
      "agent": "e2e-runner",
      "subtask": true
    },
    "refactor-clean": {
      "description": "Remove dead code and consolidate duplicates",
      "template": "{file:commands/refactor-clean.md}\n\n$ARGUMENTS",
      "agent": "refactor-cleaner",
      "subtask": true
    },
    "orchestrate": {
      "description": "Orchestrate multiple agents for complex tasks",
      "template": "{file:commands/orchestrate.md}\n\n$ARGUMENTS",
      "agent": "planner",
      "subtask": true
    },
    "learn": {
      "description": "Extract patterns and learnings from session",
      "template": "{file:commands/learn.md}\n\n$ARGUMENTS"
    },
    "checkpoint": {
      "description": "Save verification state and progress",
      "template": "{file:commands/checkpoint.md}\n\n$ARGUMENTS"
    },
    "verify": {
      "description": "Run verification loop",
      "template": "{file:commands/verify.md}\n\n$ARGUMENTS"
    },
    "eval": {
      "description": "Run evaluation against criteria",
      "template": "{file:commands/eval.md}\n\n$ARGUMENTS"
    },
    "update-docs": {
      "description": "Update documentation",
      "template": "{file:commands/update-docs.md}\n\n$ARGUMENTS",
      "agent": "doc-updater",
      "subtask": true
    },
    "update-codemaps": {
      "description": "Update codemaps",
      "template": "{file:commands/update-codemaps.md}\n\n$ARGUMENTS",
      "agent": "doc-updater",
      "subtask": true
    },
    "test-coverage": {
      "description": "Analyze test coverage",
      "template": "{file:commands/test-coverage.md}\n\n$ARGUMENTS",
      "agent": "tdd-guide",
      "subtask": true
    },
    "setup-pm": {
      "description": "Configure package manager",
      "template": "{file:commands/setup-pm.md}\n\n$ARGUMENTS"
    },
    "debug": {
      "description": "Debug sistematis — root cause dulu, baru fix",
      "template": "{file:commands/debug.md}\n\n$ARGUMENTS",
      "subtask": true
    },
    "ship": {
      "description": "Ship — verifikasi, review, putuskan merge/rebase/PR",
      "template": "{file:commands/ship.md}\n\n$ARGUMENTS",
      "subtask": true
    },
    "night-shift": {
      "description": "Siapkan night-task untuk jalan tanpa pengawasan (full-auto default)",
      "template": "{file:commands/night-shift.md}\n\n$ARGUMENTS",
      "agent": "planner",
      "subtask": true
    },
    "night-shift-session": {
      "description": "Jarvis dalam sesi — loop improvisasi mandiri atas transkrip berjalan",
      "template": "{file:commands/night-shift-session.md}\n\n$ARGUMENTS",
      "agent": "night-shift-session",
      "subtask": true
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      },
      "enabled": false
    }
  },
  "permission": {
    "read:**/.env": "deny",
    "read:**/.env.*": "deny",
    "read:**/.env.local": "deny",
    "read:**/.env.production": "deny",
    "read:**/.env.development": "deny",
    "read:**/*secret*": "deny",
    "read:**/*credential*": "deny",
    "read:**/.git/**": "deny",
    "read:**/node_modules/**": "deny",
    "read:**/*.pem": "deny",
    "read:**/*.key": "deny",
    "read:**/.ssh/**": "deny",
    "external_directory": {
      "~/.config/opencode/rules/*": "allow",
      "~/.config/opencode/prompts/*": "allow",
      "~/.config/opencode/prompts/agents/*": "allow",
      "~/.config/opencode/instructions/*": "allow",
      "~/.config/opencode/commands/*": "allow",
      "~/.config/opencode/skills/*": "allow"
    },
    "edit:**/.env*": "deny",
    "bash": {
      "git *": "allow",
      "gh *": "allow",
      "npx tsc --noEmit": "allow",
      "rm -rf *": "deny",
      "*": "allow"
    },
    "mcp_*": "ask"
  },
  "formatter": true,
  "compaction": { "auto": true, "tail_turns": 15 },
  "tool_output": { "max_lines": 200, "max_bytes": 8192 }
}
